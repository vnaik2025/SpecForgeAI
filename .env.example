# ====================================================================
# MINI-REPORTS PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ====================================================================

# Security: Set a long random string for production (generate with: openssl rand -base64 48)
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production

# Debug: Set to False in production
DEBUG=False

# Hostnames allowed to connect (comma-separated, e.g. api.yourdomain.com,yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins for HTTPS (e.g. https://yourdomain.com,https://api.yourdomain.com)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SSL / HTTPS Redirect (Set True in production with SSL, False for local dev or behind reverse proxy)
SECURE_SSL_REDIRECT=False

# Database URL: Leave blank to use SQLite, or supply PostgreSQL / MySQL connection string:
# DATABASE_URL=postgres://user:password@localhost:5432/mini_reports
DATABASE_URL=

# AI Configuration (Google Gemini / OpenAI)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_REQUEST_TIMEOUT=60.0

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
